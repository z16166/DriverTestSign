#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "TestSign.manifest"

#ifndef APSTUDIO_READONLY_SYMBOLS
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(65001)
#endif

IDD_MAIN DIALOGEX 0, 0, 456, 324
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "TestSign  /  驱动测试签名"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "密钥",IDC_GROUP_KEY,10,8,436,90
    LTEXT           "PFX 路径",IDC_LABEL_KEY,22,42,48,12
    EDITTEXT        IDC_KEY_PATH,74,40,248,16,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览",IDC_BROWSE_KEY,328,38,54,20,BS_OWNERDRAW
    PUSHBUTTON      "生成",IDC_GENERATE,386,38,50,20,BS_OWNERDRAW
    PUSHBUTTON      "导入到本机受信任根证书",IDC_IMPORT,22,64,248,22,BS_OWNERDRAW

    GROUPBOX        "驱动程序",IDC_GROUP_DRV,10,106,436,72
    LTEXT           "SYS 路径",IDC_LABEL_SYS,22,140,48,12
    EDITTEXT        IDC_SYS_PATH,74,138,248,16,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览",IDC_BROWSE_SYS,328,136,54,20,BS_OWNERDRAW
    PUSHBUTTON      "签名",IDC_SIGN,386,136,50,20,BS_OWNERDRAW

    GROUPBOX        "状态",IDC_GROUP_LOG,10,186,436,108
    EDITTEXT        IDC_STATUS,22,214,412,70,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "关闭",IDCANCEL,392,300,54,18,BS_OWNERDRAW
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "TestSign 驱动测试签名管理"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "TestSign"
            VALUE "LegalCopyright", "TestSign"
            VALUE "OriginalFilename", "TestSign.exe"
            VALUE "ProductName", "TestSign"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
