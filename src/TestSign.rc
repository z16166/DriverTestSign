#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "TestSign.manifest"

#ifndef APSTUDIO_READONLY_SYMBOLS
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(65001)
#endif

IDD_MAIN DIALOGEX 0, 0, 456, 348
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "TestSign  /  Driver Test Signing"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Key",IDC_GROUP_KEY,10,8,436,90
    LTEXT           "PFX path",IDC_LABEL_KEY,22,42,70,12
    EDITTEXT        IDC_KEY_PATH,96,40,226,16,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",IDC_BROWSE_KEY,328,38,54,20,BS_OWNERDRAW
    PUSHBUTTON      "Generate",IDC_GENERATE,386,38,50,20,BS_OWNERDRAW
    PUSHBUTTON      "Import to local trusted root",IDC_IMPORT,22,64,248,22,BS_OWNERDRAW

    GROUPBOX        "Driver",IDC_GROUP_DRV,10,106,436,96
    LTEXT           "SYS/EXE path",IDC_LABEL_SYS,22,128,70,12
    EDITTEXT        IDC_SYS_PATH,96,126,226,16,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",IDC_BROWSE_SYS,328,124,54,20,BS_OWNERDRAW
    PUSHBUTTON      "Sign",IDC_SIGN,386,124,50,20,BS_OWNERDRAW
    LTEXT           "INF path",IDC_LABEL_INF,22,156,70,12
    EDITTEXT        IDC_INF_PATH,96,154,226,16,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",IDC_BROWSE_INF,328,152,54,20,BS_OWNERDRAW
    PUSHBUTTON      "Catalog",IDC_SIGN_CAT,386,152,50,20,BS_OWNERDRAW

    GROUPBOX        "Status",IDC_GROUP_LOG,10,210,436,108
    EDITTEXT        IDC_STATUS,22,238,412,70,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Theme",IDC_LABEL_THEME,12,327,24,12
    COMBOBOX        IDC_THEME,38,324,92,110,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Language",IDC_LABEL_LANG,138,327,44,12
    COMBOBOX        IDC_LANGUAGE,184,324,92,110,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Close",IDCANCEL,392,324,54,18,BS_OWNERDRAW
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "TestSign 驱动测试签名管理"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "TestSign"
            VALUE "LegalCopyright", "TestSign"
            VALUE "OriginalFilename", "TestSign.exe"
            VALUE "ProductName", "TestSign"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
